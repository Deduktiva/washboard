<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixture: rpc/literal. The soap:body namespace equals the inline schema's targetNamespace,
     so a generated wrapper schema for the rpc operations shares a namespace with a real one
     (docs/PLAN.md §5.4). Also contains one rpc/encoded binding that must load as unsupported. -->
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="urn:example:legacy"
                  targetNamespace="urn:example:legacy">
  <wsdl:types>
    <xs:schema targetNamespace="urn:example:legacy">
      <xs:complexType name="Address">
        <xs:sequence>
          <xs:element name="street" type="xs:string"/>
          <xs:element name="city" type="xs:string"/>
          <xs:element name="zip" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
    </xs:schema>
  </wsdl:types>

  <wsdl:message name="LookupRequest">
    <wsdl:part name="customerNo" type="xs:string"/>
    <wsdl:part name="asOf" type="xs:date"/>
  </wsdl:message>
  <wsdl:message name="LookupResponse">
    <wsdl:part name="result" type="tns:Address"/>
  </wsdl:message>

  <wsdl:portType name="LegacyPortType">
    <wsdl:operation name="Lookup">
      <wsdl:input message="tns:LookupRequest"/>
      <wsdl:output message="tns:LookupResponse"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="LegacyBinding" type="tns:LegacyPortType">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="Lookup">
      <soap:operation soapAction="urn:example:legacy#Lookup"/>
      <wsdl:input><soap:body use="literal" namespace="urn:example:legacy"/></wsdl:input>
      <wsdl:output><soap:body use="literal" namespace="urn:example:legacy"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:binding name="LegacyEncodedBinding" type="tns:LegacyPortType">
    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="Lookup">
      <soap:operation soapAction="urn:example:legacy#Lookup"/>
      <wsdl:input>
        <soap:body use="encoded" namespace="urn:example:legacy"
                   encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="encoded" namespace="urn:example:legacy"
                   encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="LegacyService">
    <wsdl:port name="LegacyPort" binding="tns:LegacyBinding">
      <soap:address location="http://legacy.example.invalid/rpc"/>
    </wsdl:port>
    <wsdl:port name="LegacyEncodedPort" binding="tns:LegacyEncodedBinding">
      <soap:address location="http://legacy.example.invalid/rpc-enc"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
